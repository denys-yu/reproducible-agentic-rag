# Secrets
.env

# Runtime artifacts. `runs/` and `results/` are deliberately NOT ignored: they carry the
# per-call provenance manifests, which are the experiment's primary evidence. Only rebuildable
# caches and the vector store stay ignored.
data/
chroma/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# IDE (volatile per-session state)
.idea/workspace.xml
